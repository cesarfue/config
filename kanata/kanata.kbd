;; Kanata configuration
;; Navigation layer: hold Space, then
;;   j/k/l/;  → Left/Down/Up/Right arrows
;;   s/d      → scroll down/up
;;   a        → Win (meta), f → Shift   (à combiner : Space+f+j = Shift+Left, etc.)

(defcfg
  process-unmapped-keys yes
)

;; Only intercept the keys we care about. Everything else passes through.
(defsrc
  a s d f spc j k l ;
)

(defalias
  ;; Space: tap = space, hold = activate navigation layer
  spc (tap-hold 200 200 spc (layer-toggle nav))

  ;; Scroll viewport: 1 notch every 50ms while held
  scrd (mwheel-down 50 120)
  scru (mwheel-up 50 120)
)

;; Base: home row keys are plain; only Space carries the navigation layer.
(deflayer base
  a s d f @spc j k l ;
)

;; Navigation: active while Space is held
(deflayer nav
  lmet @scrd @scru lsft spc left down up rght
)
